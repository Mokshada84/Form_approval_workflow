# Copy this file to `.env` and put your real key in it.
#
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) — the key must never be committed,
# and it must never reach the browser. Only the server in `server/` reads it.
#
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port the API server listens on. The Vite dev server proxies /api here.
PORT=8787
